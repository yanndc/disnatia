generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PortfolioImport {
  id             String                     @id @default(cuid())
  sourceFileName String
  /// Octets bruts du fichier importé (CSV / Excel). Supprimés avec la ligne (DELETE import).
  sourceFileContent Bytes?                  @map("source_file_content")
  /// Indique si un contenu est stocké (évite de charger le blob pour les listes).
  sourceFileKept    Boolean                  @default(false) @map("source_file_kept")
  importedAt     DateTime                   @default(now())
  /// Borne basse des dates présentes dans le fichier (ex. min date d’opération).
  dataFromDate   DateTime?
  /// Borne haute des dates dans le fichier (ex. max date d’opération) ; référence d’« état » pour l’activité.
  dataToDate     DateTime?
  status         ImportStatus               @default(COMPLETED)
  importType     ImportType                 @default(PORTFOLIO)
  rawHeaderJson  Json
  rawRowCount    Int
  notes          String?
  accounts       PortfolioAccount[]
  positions      PortfolioPosition[]
  transactions   PortfolioTransactionLine[]

  @@map("portfolio_imports")
}

model PortfolioAccount {
  id             String              @id @default(cuid())
  importId       String
  accountName    String
  accountNumber  String?
  accountType    String?
  currency       String
  cashValue      Float               @default(0)
  marketValue    Float               @default(0)
  totalValue     Float               @default(0)
  import         PortfolioImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  positions      PortfolioPosition[]

  @@index([importId])
  @@index([accountNumber])
  @@map("portfolio_accounts")
}

model PortfolioPosition {
  id                 String            @id @default(cuid())
  importId           String
  accountId          String?
  accountNumber      String?
  ticker             String
  securityName       String?
  currency           String
  quantity           Float
  averageCost        Float?
  marketPrice        Float?
  marketValue        Float
  unrealizedGainLoss Float?
  /** Valeur d'emprunt (marge) si présente dans l'export Disnat */
  loanValue          Float?          @map("loan_value")
  weightPct          Float?
  sector             String?
  assetType          String?
  import             PortfolioImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  account            PortfolioAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([ticker])
  @@index([accountNumber])
  @@map("portfolio_positions")
}

/**
 * État courant synthétisé du portefeuille — une ligne par (compte + ticker + devise).
 * Mis à jour à chaque import snapshot plus récent que la date déjà connue pour ce compte.
 * Lecture principale du tableau de bord (PAS le dernier fichier).
 */
model PortfolioHolding {
  id                 String    @id @default(cuid())
  /// Numéro de compte normalisé (clé stable)
  accountKey         String
  accountName        String
  accountNumber      String?
  accountType        String?
  ticker             String
  securityName       String?
  currency           String
  quantity           Float
  averageCost        Float?
  snapshotPrice      Float?
  snapshotValue      Float
  unrealizedGainLoss Float?
  loanValue          Float?          @map("loan_value")
  sector             String?
  assetType          String?
  /// Date de référence des données (dataToDate de l'import ou importedAt)
  asOf               DateTime
  sourceImportId     String
  updatedAt          DateTime  @updatedAt

  @@unique([accountKey, ticker, currency])
  @@index([ticker])
  @@index([accountKey])
  @@map("portfolio_holdings")
}

/**
 * État courant synthétisé des comptes — une ligne par (compte + devise).
 * Champs `cashValue`, `marketValue`, `totalValue` : dernier snapshot **import portefeuille** ;
 * ils servent de référence de réconciliation avec Disnat (vérité fichier au `asOf`), pas de reconstruction depuis les opérations.
 */
model PortfolioAccountState {
  id            String   @id @default(cuid())
  accountKey    String
  accountName   String
  accountNumber String?
  accountType   String?
  /// Propriétaire du compte (ex. "YANN DE CHAMPLAIN")
  owner         String?
  currency      String
  /// Encaisse selon le dernier export portefeuille accepté — référence de réconciliation.
  cashValue     Float    @default(0)
  marketValue   Float    @default(0)
  totalValue    Float    @default(0)
  asOf          DateTime
  sourceImportId String
  updatedAt     DateTime @updatedAt

  @@unique([accountKey, currency])
  @@index([accountKey])
  @@index([owner])
  @@map("portfolio_account_states")
}

/**
 * Attestation « aucune transaction depuis » pour un compte dormant.
 *
 * Permet de sortir un compte des alertes de péremption sans réimporter un historique :
 * `dataAsOf` = date jusqu'à laquelle l'historique des opérations est jugé complet,
 * `confirmedAt` = date de la confirmation (audit). Ne modifie jamais les montants de
 * `PortfolioAccountState` : la valorisation reste celle du dernier export portefeuille.
 */
model PortfolioAccountConfirmation {
  id          String   @id @default(cuid())
  accountKey  String
  /// Dernier jour couvert par l'attestation (UTC, jour civil).
  dataAsOf    DateTime @db.Date
  confirmedAt DateTime @default(now())
  /// MANUAL (session guidée) | IMPORT (import de transactions couvrant la date)
  source      String   @default("MANUAL")
  note        String?
  /// Copie des montants attestés au moment de la confirmation (preuve, non recalculée).
  totalValue  Float?
  cashValue   Float?
  marketValue Float?

  @@index([accountKey, dataAsOf])
  @@index([confirmedAt])
  @@map("portfolio_account_confirmations")
}

/**
 * Règle apprise « fichier Disnat → compte » pendant une session d'import guidée.
 *
 * Les exports « Historique des transactions » ne contiennent aucun numéro de compte :
 * la signature (nom de fichier normalisé + forme des colonnes) mémorise l'attribution
 * validée une première fois pour éviter de la redemander.
 */
model PortfolioImportAttributionRule {
  id             String   @id @default(cuid())
  signature      String   @unique
  accountKey     String
  sampleFileName String
  hits           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountKey])
  @@map("portfolio_import_attribution_rules")
}

/// Dernier cours connu pour une ligne (ticker + devise ligne Disnat). Non lié à un import : sert au tableau de bord « en cours ».
model PortfolioLiveQuote {
  id          String   @id @default(cuid())
  ticker      String
  currency    String
  price       Float
  /// Variation nominale de la séance (ex. champ regularMarketChange Yahoo)
  /// @map: colonnes créées via migration SQL (snake_case) sur Supabase
  changeAmount   Float?   @map("change_amount")
  previousClose  Float?   @map("previous_close")
  fetchedAt   DateTime @default(now())
  yahooSymbol String?

  @@unique([ticker, currency])
  @@map("portfolio_live_quotes")
}

/// Prix historique journalier normalisé par ticker/devise.
/// Rempli par jobs de marché ; utilisé par les rapports "valeur à telle date".
model PortfolioDailyPrice {
  id          String   @id @default(cuid())
  ticker      String
  currency    String
  priceDate   DateTime @db.Date
  closePrice  Float
  source      String   @default("yahoo")
  yahooSymbol String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ticker, currency, priceDate])
  @@index([priceDate])
  @@index([ticker])
  @@map("portfolio_daily_prices")
}

/// Quantité détenue par jour, dérivée des transactions.
/// Cette table évite de rejouer les CSV au rendu des pages.
model PortfolioDailyHolding {
  id           String   @id @default(cuid())
  holdingDate  DateTime @db.Date
  accountKey   String
  accountName  String?
  accountNumber String?
  ticker       String
  securityName String?
  currency     String
  quantity     Float
  averageCost  Float?
  source       String   @default("transactions")
  updatedAt    DateTime @updatedAt

  @@unique([holdingDate, accountKey, ticker, currency])
  @@index([holdingDate])
  @@index([accountKey])
  @@index([ticker])
  @@map("portfolio_daily_holdings")
}

/// Valeur totale journalière du portefeuille, issue des holdings + prix historiques.
model PortfolioDailyValue {
  id             String   @id @default(cuid())
  valueDate      DateTime @db.Date
  currency       String
  positionsValue Float    @default(0)
  cashValue      Float    @default(0)
  totalValue     Float    @default(0)
  source         String   @default("projection")
  updatedAt      DateTime @updatedAt

  @@unique([valueDate, currency])
  @@index([valueDate])
  @@map("portfolio_daily_values")
}

/// P&L titres par compte et par séance (persisté au refresh des cours).
model PortfolioDailyAccountSessionGain {
  id           String   @id @default(cuid())
  sessionDate  DateTime @db.Date
  accountKey   String
  currency     String
  gainNative   Float
  priorNative  Float
  source       String   @default("holdings_closes")
  updatedAt    DateTime @updatedAt

  @@unique([sessionDate, accountKey])
  @@index([sessionDate])
  @@index([accountKey])
  @@map("portfolio_daily_account_session_gains")
}

/**
 * Indicateurs performance précalculés (owner × période × portée × séance).
 * Versionnés via calcVersion — ne pas recalculer rétroactivement sans bump.
 */
model PortfolioPerformanceSnapshot {
  id                   String   @id @default(cuid())
  sessionDate          DateTime @map("session_date") @db.Date
  calcVersion          Int      @map("calc_version")
  periodId             String   @map("period_id")
  scopeKey             String   @map("scope_key")
  owner                String?  @map("owner")
  scopePreset          String   @map("scope_preset")
  label                String
  shortLabel           String   @map("short_label")
  gainCad              Float?   @map("gain_cad")
  gainPct              Float?   @map("gain_pct")
  currentCad           Float    @map("current_cad")
  baselineCad          Float?   @map("baseline_cad")
  baselineDate         String?  @map("baseline_date")
  periodStart          String?  @map("period_start")
  periodEnd            String   @map("period_end")
  method               String
  accountsIncluded     Int      @map("accounts_included")
  accountsWithBaseline Int      @map("accounts_with_baseline")
  incomplete           Boolean  @default(false)
  annualized           Boolean  @default(false)
  note                 String?
  computedAt           DateTime @default(now()) @map("computed_at")

  @@unique([sessionDate, calcVersion, periodId, scopeKey])
  @@index([sessionDate, calcVersion])
  @@index([scopeKey])
  @@map("portfolio_performance_snapshots")
}

model PortfolioTransactionLine {
  id              String      @id @default(cuid())
  importId        String
  /// Numéro de compte Disnat associé (lié au snapshot de portefeuille)
  accountKey      String?
  accountName     String?
  accountNumber   String?
  tradeDate       DateTime?
  settlementDate  DateTime?
  transactionType String?
  /// Catégorie normalisée déduite du type Disnat brut
  txCategory      TxCategory?
  ticker          String?
  securityName    String?
  /// Marché (CAN, USA, …)
  market          String?
  currency        String?
  /// Devise du prix (peut différer de la devise du compte)
  priceDevise     String?
  /// Classe d'actif brute Disnat (Actions, Fonds, …)
  assetClass      String?
  quantity        Float?
  price           Float?
  amount          Float?
  fees            Float?
  rawJson         Json
  /// Empreinte déterministe (sha256) pour détecter les doublons à l'import
  fingerprint     String?  @unique
  import          PortfolioImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([ticker])
  @@index([tradeDate])
  @@index([accountKey])
  @@index([txCategory])
  @@map("portfolio_transaction_lines")
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("Conversation portefeuille")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         MessageRole
  content      String
  createdAt    DateTime    @default(now())
  metadataJson Json?
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

/// Règles / instructions utilisateur persistées — prolongent le prompt système de Pinocchio (une ligne par déploiement).
model PinocchioAgentRules {
  id        String   @id @default("default")
  body      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("pinocchio_agent_rules")
}

enum TxCategory {
  BUY
  SELL
  DIVIDEND
  INTEREST
  TAX_WITHHOLD
  CONTRIBUTION
  TRANSFER_IN
  TRANSFER_OUT
  INTERNAL_TRANSFER
  REVERSAL
  FEE
  STOCK_SPLIT
  STOCK_DIVIDEND
  EXCHANGE
  TERMINATION
  JOURNAL
  OTHER
}

enum ImportStatus {
  COMPLETED
  FAILED
}

enum ImportType {
  PORTFOLIO
  POSITIONS
  TRANSACTIONS
  MIXED
  UNKNOWN
}

enum MessageRole {
  user
  assistant
  system
  tool
}

enum NonFinancialAssetType {
  REAL_ESTATE
  VEHICLE
  PRIVATE_BUSINESS
  OTHER
}

enum PortfolioKind {
  PERSONAL
  HOUSEHOLD
  CUSTOM
}

enum OwnerMappingSource {
  MANUAL
  BACKFILL
  IMPORT
}

/**
 * Cours quotidien USD → CAD (nombre de dollars canadiens pour 1 USD).
 * Alimenté via la série FXUSDCAD de la Banque du Canada ; les jours sans publication
 * (fins de semaine, fériés) sont complétés en reportant le dernier cours connu.
 */
model UsdCadDailyRate {
  id       String   @id @default(cuid())
  rateDate DateTime @map("rate_date") @db.Date
  usdToCad Float    @map("usd_to_cad")
  source   String   @default("bank_of_canada")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rateDate])
  @@index([rateDate])
  @@map("usd_cad_daily_rates")
}

/**
 * Compte hors Disnat (ex. REER collectif assureur). Pas d’API publique :
 * l’utilisateur saisit des snapshots de valeur périodiques depuis l’espace participant.
 */
model ExternalPortfolioAccount {
  id           String                   @id @default(cuid())
  /// Identifiant logique (ex. `desjardins_erc_reer_collectif`)
  provider     String
  displayLabel String
  /// Propriétaire (même logique d’affichage que les comptes Disnat)
  owner        String?
  /// Clé stable pour l’UI ; préfixe `ext:` pour éviter les collisions Disnat
  accountKey   String                   @unique
  currency     String                   @default("CAD")
  portalUrl    String?
  metadata     Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  snapshots    ExternalAccountSnapshot[]
  ownerMapping ExternalPortfolioAccountOwner?

  @@index([provider])
  @@index([owner])
  @@map("external_portfolio_accounts")
}

model ExternalAccountSnapshot {
  id                String                 @id @default(cuid())
  externalAccountId String
  asOfDate          DateTime               @db.Date
  totalValue        Float
  notes             String?
  createdAt         DateTime               @default(now())
  externalAccount   ExternalPortfolioAccount @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)

  @@unique([externalAccountId, asOfDate])
  @@index([externalAccountId])
  @@index([asOfDate])
  @@map("external_account_snapshots")
}

/** Propriétaire canonique (clé stable) pour éviter les ambiguïtés des champs texte libres. */
model Owner {
  id          String                         @id @default(cuid())
  ownerKey    String                         @unique
  displayName String
  isActive    Boolean                        @default(true)
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  portfolios  PortfolioOwnerMembership[]
  accountMappings PortfolioAccountOwner[]
  externalAccountMappings ExternalPortfolioAccountOwner[]
  nonFinancialAssetShares NonFinancialAssetOwnerShare[]

  @@index([displayName])
  @@map("owners")
}

/** Portefeuille logique (personnel, ménage, personnalisé). */
model Portfolio {
  id           String                    @id @default(cuid())
  portfolioKey String                    @unique
  displayName  String
  kind         PortfolioKind             @default(CUSTOM)
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  owners       PortfolioOwnerMembership[]

  @@index([displayName])
  @@map("portfolios")
}

model PortfolioOwnerMembership {
  id          String    @id @default(cuid())
  portfolioId String
  ownerId     String
  weightPct   Float     @default(100)
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, ownerId])
  @@index([ownerId])
  @@map("portfolio_owner_memberships")
}

/** Mapping d’un compte Disnat (accountKey) vers propriétaire canonique. */
model PortfolioAccountOwner {
  id        String             @id @default(cuid())
  accountKey String            @unique
  ownerId   String
  source    OwnerMappingSource @default(BACKFILL)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  owner     Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("portfolio_account_owners")
}

/** Mapping d’un compte externe vers propriétaire canonique. */
model ExternalPortfolioAccountOwner {
  id                String             @id @default(cuid())
  externalAccountId String             @unique
  ownerId           String
  source            OwnerMappingSource @default(BACKFILL)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  externalAccount   ExternalPortfolioAccount @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)
  owner             Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("external_portfolio_account_owners")
}

/**
 * Actif non-boursier (ex. résidence principale) valorisé par snapshots manuels.
 * Utilisé pour le patrimoine net, sans l'inclure dans les rendements portefeuille.
 */
model NonFinancialAsset {
  id          String                     @id @default(cuid())
  /// Clé stable UI ; préfixe `asset:` pour éviter collisions avec comptes
  assetKey    String                     @unique
  assetType   NonFinancialAssetType      @default(REAL_ESTATE)
  displayLabel String
  owner       String?
  currency    String                     @default("CAD")
  isActive    Boolean                    @default(true)
  metadata    Json?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  snapshots   NonFinancialAssetSnapshot[]
  ownerShares NonFinancialAssetOwnerShare[]

  @@index([owner])
  @@index([assetType])
  @@index([isActive])
  @@map("non_financial_assets")
}

model NonFinancialAssetSnapshot {
  id                  String            @id @default(cuid())
  nonFinancialAssetId String
  asOfDate            DateTime          @db.Date
  marketValue         Float
  mortgageBalance     Float             @default(0)
  netEquity           Float
  notes               String?
  createdAt           DateTime          @default(now())
  asset               NonFinancialAsset @relation(fields: [nonFinancialAssetId], references: [id], onDelete: Cascade)

  @@unique([nonFinancialAssetId, asOfDate])
  @@index([nonFinancialAssetId])
  @@index([asOfDate])
  @@map("non_financial_asset_snapshots")
}

/** Répartition de propriété d’un actif non-boursier entre plusieurs propriétaires. */
model NonFinancialAssetOwnerShare {
  id                  String             @id @default(cuid())
  nonFinancialAssetId String
  ownerId             String
  sharePct            Float
  source              OwnerMappingSource @default(BACKFILL)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  asset               NonFinancialAsset  @relation(fields: [nonFinancialAssetId], references: [id], onDelete: Cascade)
  owner               Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([nonFinancialAssetId, ownerId])
  @@index([ownerId])
  @@map("non_financial_asset_owner_shares")
}

/// ---------------------------------------------------------------------------
/// Fil de nouvelles d'investissement (RSS/Atom ingéré + scoring portefeuille)
/// ---------------------------------------------------------------------------
enum NewsCategory {
  MARKETS
  COMPANY
  ECONOMY
  REAL_ESTATE
  PERSONAL_FINANCE
  OTHER
}

/// `RSS` = flux éditorial fixe ; `AUTO_TICKER` = flux construit par titre détenu (Yahoo, gabarit `{symbol}`).
enum NewsSourceKind {
  RSS
  AUTO_TICKER
}

/// Flux déclaré et gérable depuis l'admin (`/imports?tab=news`).
model NewsSource {
  id            String          @id @default(cuid())
  /// Identifiant stable du registre de départ (seed idempotent).
  slug          String          @unique
  name          String
  feedUrl       String
  homepageUrl   String?
  kind          NewsSourceKind  @default(RSS)
  language      String          @default("fr")
  category      NewsCategory    @default(OTHER)
  /// Pondération de confiance utilisée dans le score de pertinence (0.2 – 2).
  weight        Float           @default(1)
  isActive      Boolean         @default(true)
  /// Issu du registre de code (réactivé au seed) vs ajouté à la main.
  isSeed        Boolean         @default(false)
  lastFetchedAt DateTime?
  lastStatus    String?
  lastError     String?
  lastItemCount Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         NewsItem[]

  @@index([isActive])
  @@map("news_sources")
}

model NewsItem {
  id               String          @id @default(cuid())
  sourceId         String
  source           NewsSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url              String
  /// URL sans paramètres de tracking — clé de déduplication multi-flux.
  canonicalUrl     String          @unique
  /// sha1(titre normalisé + domaine) — capte les republications sur des URLs différentes.
  fingerprint      String          @unique
  title            String
  excerpt          String?
  /// Média d'origine quand le flux agrège (ex. « Les Affaires » via Google Actualités).
  publisher        String?
  imageUrl         String?
  author           String?
  language         String          @default("fr")
  category         NewsCategory    @default(OTHER)
  tags             String[]        @default([])
  publishedAt      DateTime
  ingestedAt       DateTime        @default(now())
  /// 0–100, recalculé à chaque passage d'ingestion.
  relevanceScore   Float           @default(0)
  /// Exposition du portefeuille touchée par les titres rattachés (snapshot du calcul).
  portfolioPct     Float?
  portfolioValueCad Float?
  readAt           DateTime?
  savedAt          DateTime?
  tickers          NewsItemTicker[]

  @@index([publishedAt, relevanceScore])
  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([sourceId, publishedAt])
  @@map("news_items")
}

/// Rattachement article → titre détenu (alimente le score et le badge d'exposition).
model NewsItemTicker {
  id          String   @id @default(cuid())
  newsItemId  String
  newsItem    NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  /// Ticker tel que lu dans le portefeuille (ex. « BCE-C »).
  ticker      String
  yahooSymbol String?
  /// TICKER | NAME | ALIAS
  matchKind   String
  confidence  Float    @default(1)
  createdAt   DateTime @default(now())

  @@unique([newsItemId, ticker])
  @@index([ticker])
  @@map("news_item_tickers")
}

/// Journal d'exécution du cron de rafraîchissement (observabilité + idempotence légère).
model NewsIngestionRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    @default("RUNNING")
  sourcesOk     Int       @default(0)
  sourcesFailed Int       @default(0)
  itemsSeen     Int       @default(0)
  itemsCreated  Int       @default(0)
  itemsUpdated  Int       @default(0)
  errorSummary  Json?

  @@index([startedAt])
  @@map("news_ingestion_runs")
}

/// Référence de rendement publiée par Disnat (onglet « Rendement de portefeuille »),
/// par client et par période — sert à mesurer l'écart avec les TWR calculés par l'app.
model DisnatPerformanceReference {
  id            String   @id @default(cuid())
  /// Code client Disnat (préfixe des numéros de compte, ex. `5KFZE`, `5L3AP`).
  clientCode    String
  /// MONTH | MONTH3 | YEAR | YEAR3 | YTD | ALL
  period        String
  valuePct      Float
  /// Date de référence affichée par Disnat (« Au 30 septembre 2026 »).
  referenceDate DateTime @db.Date
  source        String   @default("MANUAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientCode, period, referenceDate])
  @@index([referenceDate])
  @@map("disnat_performance_references")
}

/// Envoi idempotent du rapport fin de journée par courriel (une ligne par séance).
model EodReportDelivery {
  sessionDate String   @id
  sentAt      DateTime @default(now())
  recipient   String

  @@map("eod_report_deliveries")
}
