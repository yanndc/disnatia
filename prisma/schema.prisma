generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PortfolioImport {
  id             String                     @id @default(cuid())
  sourceFileName String
  importedAt     DateTime                   @default(now())
  /// Borne basse des dates présentes dans le fichier (ex. min date d’opération).
  dataFromDate   DateTime?
  /// Borne haute des dates dans le fichier (ex. max date d’opération) ; référence d’« état » pour l’activité.
  dataToDate     DateTime?
  status         ImportStatus               @default(COMPLETED)
  importType     ImportType                 @default(PORTFOLIO)
  rawHeaderJson  Json
  rawRowCount    Int
  notes          String?
  accounts       PortfolioAccount[]
  positions      PortfolioPosition[]
  transactions   PortfolioTransactionLine[]

  @@map("portfolio_imports")
}

model PortfolioAccount {
  id             String              @id @default(cuid())
  importId       String
  accountName    String
  accountNumber  String?
  accountType    String?
  currency       String
  cashValue      Float               @default(0)
  marketValue    Float               @default(0)
  totalValue     Float               @default(0)
  import         PortfolioImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  positions      PortfolioPosition[]

  @@index([importId])
  @@index([accountNumber])
  @@map("portfolio_accounts")
}

model PortfolioPosition {
  id                 String            @id @default(cuid())
  importId           String
  accountId          String?
  accountNumber      String?
  ticker             String
  securityName       String?
  currency           String
  quantity           Float
  averageCost        Float?
  marketPrice        Float?
  marketValue        Float
  unrealizedGainLoss Float?
  weightPct          Float?
  sector             String?
  assetType          String?
  import             PortfolioImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  account            PortfolioAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([ticker])
  @@index([accountNumber])
  @@map("portfolio_positions")
}

/**
 * État courant synthétisé du portefeuille — une ligne par (compte + ticker + devise).
 * Mis à jour à chaque import snapshot plus récent que la date déjà connue pour ce compte.
 * Lecture principale du tableau de bord (PAS le dernier fichier).
 */
model PortfolioHolding {
  id                 String    @id @default(cuid())
  /// Numéro de compte normalisé (clé stable)
  accountKey         String
  accountName        String
  accountNumber      String?
  accountType        String?
  ticker             String
  securityName       String?
  currency           String
  quantity           Float
  averageCost        Float?
  snapshotPrice      Float?
  snapshotValue      Float
  unrealizedGainLoss Float?
  sector             String?
  assetType          String?
  /// Date de référence des données (dataToDate de l'import ou importedAt)
  asOf               DateTime
  sourceImportId     String
  updatedAt          DateTime  @updatedAt

  @@unique([accountKey, ticker, currency])
  @@index([ticker])
  @@index([accountKey])
  @@map("portfolio_holdings")
}

/**
 * État courant synthétisé des comptes — une ligne par (compte + devise).
 * Encaisse, valeur titres et total issus du dernier snapshot connu pour ce compte.
 */
model PortfolioAccountState {
  id            String   @id @default(cuid())
  accountKey    String
  accountName   String
  accountNumber String?
  accountType   String?
  /// Propriétaire du compte (ex. "YANN DE CHAMPLAIN")
  owner         String?
  currency      String
  cashValue     Float    @default(0)
  marketValue   Float    @default(0)
  totalValue    Float    @default(0)
  asOf          DateTime
  sourceImportId String
  updatedAt     DateTime @updatedAt

  @@unique([accountKey, currency])
  @@index([accountKey])
  @@index([owner])
  @@map("portfolio_account_states")
}

/// Dernier cours connu pour une ligne (ticker + devise ligne Disnat). Non lié à un import : sert au tableau de bord « en cours ».
model PortfolioLiveQuote {
  id          String   @id @default(cuid())
  ticker      String
  currency    String
  price       Float
  fetchedAt   DateTime @default(now())
  yahooSymbol String?

  @@unique([ticker, currency])
  @@map("portfolio_live_quotes")
}

/// Prix historique journalier normalisé par ticker/devise.
/// Rempli par jobs de marché ; utilisé par les rapports "valeur à telle date".
model PortfolioDailyPrice {
  id          String   @id @default(cuid())
  ticker      String
  currency    String
  priceDate   DateTime @db.Date
  closePrice  Float
  source      String   @default("yahoo")
  yahooSymbol String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ticker, currency, priceDate])
  @@index([priceDate])
  @@index([ticker])
  @@map("portfolio_daily_prices")
}

/// Quantité détenue par jour, dérivée des transactions.
/// Cette table évite de rejouer les CSV au rendu des pages.
model PortfolioDailyHolding {
  id           String   @id @default(cuid())
  holdingDate  DateTime @db.Date
  accountKey   String
  accountName  String?
  accountNumber String?
  ticker       String
  securityName String?
  currency     String
  quantity     Float
  averageCost  Float?
  source       String   @default("transactions")
  updatedAt    DateTime @updatedAt

  @@unique([holdingDate, accountKey, ticker, currency])
  @@index([holdingDate])
  @@index([accountKey])
  @@index([ticker])
  @@map("portfolio_daily_holdings")
}

/// Valeur totale journalière du portefeuille, issue des holdings + prix historiques.
model PortfolioDailyValue {
  id             String   @id @default(cuid())
  valueDate      DateTime @db.Date
  currency       String
  positionsValue Float    @default(0)
  cashValue      Float    @default(0)
  totalValue     Float    @default(0)
  source         String   @default("projection")
  updatedAt      DateTime @updatedAt

  @@unique([valueDate, currency])
  @@index([valueDate])
  @@map("portfolio_daily_values")
}

model PortfolioTransactionLine {
  id              String      @id @default(cuid())
  importId        String
  /// Numéro de compte Disnat associé (lié au snapshot de portefeuille)
  accountKey      String?
  accountName     String?
  accountNumber   String?
  tradeDate       DateTime?
  settlementDate  DateTime?
  transactionType String?
  /// Catégorie normalisée déduite du type Disnat brut
  txCategory      TxCategory?
  ticker          String?
  securityName    String?
  /// Marché (CAN, USA, …)
  market          String?
  currency        String?
  /// Devise du prix (peut différer de la devise du compte)
  priceDevise     String?
  /// Classe d'actif brute Disnat (Actions, Fonds, …)
  assetClass      String?
  quantity        Float?
  price           Float?
  amount          Float?
  fees            Float?
  rawJson         Json
  /// Empreinte déterministe (sha256) pour détecter les doublons à l'import
  fingerprint     String?  @unique
  import          PortfolioImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([ticker])
  @@index([tradeDate])
  @@index([accountKey])
  @@index([txCategory])
  @@map("portfolio_transaction_lines")
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("Conversation portefeuille")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         MessageRole
  content      String
  createdAt    DateTime    @default(now())
  metadataJson Json?
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

enum TxCategory {
  BUY
  SELL
  DIVIDEND
  INTEREST
  TAX_WITHHOLD
  CONTRIBUTION
  TRANSFER_IN
  TRANSFER_OUT
  INTERNAL_TRANSFER
  REVERSAL
  FEE
  STOCK_SPLIT
  STOCK_DIVIDEND
  EXCHANGE
  TERMINATION
  JOURNAL
  OTHER
}

enum ImportStatus {
  COMPLETED
  FAILED
}

enum ImportType {
  PORTFOLIO
  POSITIONS
  TRANSACTIONS
  MIXED
  UNKNOWN
}

enum MessageRole {
  user
  assistant
  system
  tool
}

/**
 * Cours quotidien USD → CAD (nombre de dollars canadiens pour 1 USD).
 * Alimenté via Frankfurter (données publiques) ; les jours sans cotation (fins de semaine)
 * sont complétés en reportant le dernier cours connu.
 */
model UsdCadDailyRate {
  id       String   @id @default(cuid())
  rateDate DateTime @map("rate_date") @db.Date
  usdToCad Float    @map("usd_to_cad")
  source   String   @default("frankfurter")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rateDate])
  @@index([rateDate])
  @@map("usd_cad_daily_rates")
}
