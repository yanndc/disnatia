# Copier vers .env.local : cp .env.example .env.local
#
# Une seule base Supabase pour dev et prod : mêmes DATABASE_URL + DIRECT_URL (et secrets utiles comme
# SITE_ACCESS_PASSWORD, OPENAI_API_KEY) sur ta machine ET dans Vercel Production → la prod doit suivre ce fichier.
# Supabase + Vercel : DATABASE_URL runtime = « Transaction pooler » (port 6543 + ?pgbouncer=true) ;
# pas la connexion directe db.*.supabase.co:5432 (IPv6, souvent mort sur Vercel). DIRECT_URL = Session pooler :5432 ou direct pour migrate.
#
# Inverse (rare) : si Vercel est déjà la référence — vercel link && vercel env pull .env.local
# ⚠️ Toute commande prisma/import locale avec une URL commune modifie la même BD que prod.

# Client Supabase JS (API HTTP / Auth / Realtime) — Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Prisma / Postgres : toujours DATABASE_URL (+ DIRECT_URL pour migrate), indépendant des deux lignes ci-dessus.

# PostgreSQL (docker : voir docker-compose.yml, port 5433 dans le README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/disnatia?schema=public"

# Optionnel Supabase migrations (pooler) — sinon laisser vide
# DIRECT_URL="postgresql://..."

# Optionnel : protège tout le site (page /site-lock). Si vide ou absent = pas de mot de passe demandé.
# SITE_ACCESS_PASSWORD="choisis-un-mot-de-passe"

# Pour /insights (Berta)
# OPENAI_API_KEY=""
