# Copier vers .env.local : cp .env.example .env.local
#
# Même .env sur Vercel (Production + Preview). Prisma :
#   DATABASE_URL = pooler Transaction :6543 ?pgbouncer=true
#   DIRECT_URL   = pooler Session :5432 (migrate préfère celle-ci)
# Client JS : NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# (SUPABASE_PROJECT_URL / SUPABASE_DATABASE_PASSWORD = inutiles pour ce repo sauf si tu les utilises ailleurs.)

# Inverse (rare) : si Vercel est déjà la référence — vercel link && vercel env pull .env.local
# ⚠️ Toute commande prisma/import locale avec une URL commune modifie la même BD que prod.

# Client Supabase JS (API HTTP / Auth / Realtime) — Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# PostgreSQL — local Docker (README) ; en prod Supabase : deux URI comme ci-dessus.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/disnatia?schema=public"
# DIRECT_URL="postgresql://..."
# TLS interrompu (VPN / inspection HTTPS) : uniquement en local, jamais en prod.
# POSTGRES_SSL_REJECT_UNAUTHORIZED=0
# Forcer TLS strict en local (rare) : POSTGRES_SSL_REJECT_UNAUTHORIZED=1

# Optionnel : mêmes secrets que sur Vercel (imports / autres scripts)
# SITE_ACCESS_PASSWORD="choisis-un-mot-de-passe"

# Pour /insights (Berta)
# OPENAI_API_KEY=""

# Rapport fin de journée par courriel — voir README § « Rapport fin de journée par courriel »
# 1) Resend  2) variables ci-dessous (Vercel)  3) pnpm prisma migrate deploy
# 4) GitHub Actions : CRON_SECRET (Secrets) + EOD_REPORT_APP_URL (Variables)
# RESEND_API_KEY="re_..."
# EOD_REPORT_FROM="DisnatIA <rapports@votredomaine.com>"
# EOD_REPORT_TO="vous@example.com"
# CRON_SECRET="secret-fort-pour-vercel-cron"
# NEXT_PUBLIC_APP_URL="https://votre-app.vercel.app"
